# =============================================================================
#  Environment variables
#
#  Every value here is a PLACEHOLDER so the app builds without real services.
#  Copy this file to `.env`, then replace the placeholders with real keys and
#  test live. `.env` is gitignored — never commit real secrets.
#
#  Placeholders are shaped like the real thing (prefixes, URL structure) so
#  code that pattern-checks them still works during the build.
# =============================================================================

# --- App ---------------------------------------------------------------------
# Public base URL of this deployment. Used for webhook callback URLs, receipt
# links, and absolute URLs in emails. Set to the Vercel URL in production.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Website Ordering Platform"

# Address that receives an email for every new PAID order.
ADMIN_EMAIL="you@example.com"

# --- Database: Neon Postgres ------------------------------------------------
# neon.tech  ->  your project  ->  Connection Details.
#   DATABASE_URL = POOLED connection  (app runtime / serverless)
#   DIRECT_URL   = DIRECT connection  (prisma migrate / introspection)
DATABASE_URL="postgresql://user:password@ep-placeholder-pooler.ap-southeast-1.aws.neon.tech/appdb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-placeholder.ap-southeast-1.aws.neon.tech/appdb?sslmode=require"

# --- Auth: Clerk ----------------------------------------------------------
# dashboard.clerk.com  ->  API Keys.
# The publishable key below is a SYNTACTICALLY VALID dummy (decodes to a fake
# host) so `next build` can parse it. It does not point at a real Clerk
# instance — auth only works once you paste your real keys here.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_Y2xlcmstcGxhY2Vob2xkZXIuZXhhbXBsZS5jb20k"
CLERK_SECRET_KEY="sk_test_placeholder00000000000000000000"
# Clerk  ->  Webhooks  ->  endpoint = <APP_URL>/api/webhooks/clerk  ->  Signing Secret.
# Needed to sync Clerk users into our User table and assign the `role`.
CLERK_WEBHOOK_SECRET="whsec_placeholder0000000000000000000000"
# Route config — leave as-is unless the route map in CLAUDE.md changes.
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/dashboard"

# --- Payments: Razorpay  (TEST MODE ONLY for now) --------------------------
# dashboard.razorpay.com  ->  Settings  ->  API Keys  ->  Generate Test Key.
RAZORPAY_KEY_ID="rzp_test_placeholder0000"
RAZORPAY_KEY_SECRET="placeholderplaceholderplaceholder"
# Same key id, exposed to the browser for Razorpay Checkout.
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_placeholder0000"
# Razorpay  ->  Settings  ->  Webhooks  ->  endpoint = <APP_URL>/api/webhooks/razorpay.
RAZORPAY_WEBHOOK_SECRET="placeholderplaceholderplaceholder"

# --- File uploads: Vercel Blob ------------------------------------------
# Vercel project  ->  Storage  ->  Blob  ->  create store  ->  read/write token.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_placeholder0000000000000000"

# --- Email: Resend ---------------------------------------------------------
# resend.com/api-keys
RESEND_API_KEY="re_placeholder_0000000000000000000000"
# A verified sender (Resend  ->  Domains). e.g. "orders@yourdomain.com"
RESEND_FROM_EMAIL="orders@example.com"
